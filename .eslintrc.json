{
  "root": true,
  "ignorePatterns": [
    "**/*"
  ],
  "plugins": [
    "react",
    "react-hooks"
  ],
  "overrides": [
    {
      "files": [
        "*.ts",
        "*.tsx",
        "*.js",
        "*.jsx"
      ],
      "rules": {
      }
    },
    {
      "files": [
        "*.ts",
        "*.tsx"
      ],
      "rules": {}
    },
    {
      "files": [
        "*.test.ts",
        "*.test.tsx"
      ],
      "env": {
        "jest": true
      }
    },
    {
      "files": [
        "*.js",
        "*.jsx"
      ],
      "rules": {}
    }
  ]
}
